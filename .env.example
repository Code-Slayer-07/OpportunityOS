# Copy to .env.local. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
TINYFISH_API_KEY=
# Optional overrides (defaults are the public TinyFish endpoints)
TINYFISH_SEARCH_URL=
TINYFISH_FETCH_URL=
GEMINI_API_KEY=
# Optional, defaults to gemini-3.1-flash-lite
GEMINI_MODEL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo reliability (see README "Demo mode")
# DEMO_MODE=true         zero external calls except Supabase: saved real rows + stored AI matches only
# MATCH_CACHE_ONLY=true  /api/match serves stored AI matches only
DEMO_MODE=
MATCH_CACHE_ONLY=
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
# Opt-in: in DEMO_MODE, pre-score the demo user at startup if it has no AI matches (calls Gemini)
DEMO_PRESCORE_ON_START=
