# Copy to .env.local. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
TINYFISH_API_KEY=
# Optional overrides (defaults are the public TinyFish endpoints)
TINYFISH_SEARCH_URL=
TINYFISH_AGENT_URL=
GEMINI_API_KEY=
# Optional, defaults to gemini-3.1-flash-lite
GEMINI_MODEL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo reliability (see README "Demo mode")
# DEMO_MODE=true      /api/discover never touches the web: serves cached/seeded data; existing matches never expire
# MATCH_CACHE_ONLY=true  /api/match serves stored matches only (no Gemini)
DEMO_MODE=
MATCH_CACHE_ONLY=
